            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.gui.controller.IntroMenuController">
    <Text layoutX="150.0" layoutY="105.0" text="IntroMenu" textAlignment="CENTER" wrappingWidth="300.0">
        <font>
            <Font size="39.0" />
        </font>
    </Text>
    <VBox layoutX="210.0" layoutY="155.0" prefWidth="180.0" spacing="12.0">
        <Button onAction="#playOffline" prefHeight="57.0" prefWidth="180.0" text="Play Offline" />
        <Button onAction="#playOnline" prefHeight="57.0" prefWidth="180.0" text="Play Online" />
