classDiagram
    direction LR

    namespace EntryPoint {
        class Main {
            +main(String[] args)$ void
            +start(Stage stage) void
        }
    }

    namespace Model {
        class Game {
            <<interface>>
            +start() void
            +finish() void
            +getGameStatus() GameStatus
        }
        class Board {
            +SIZE int$
            +PLAYER_X_MARKER char$
            +PLAYER_0_MARKER char$
            +EMPTY_MARKER char$
            -char[][] board
            +isBoardFull() boolean
            +getBoard() char[][]
            +isValidBoxNumber(int boxNumber) boolean
            +isBoxNumberEmpty(int boxNumber) boolean
            +placeMarker(int boxNumber, char marker) boolean
        }
        class Player {
            -char marker
            +getMarker() char
        }
        class TicTacToeGame {
            -Board board
            -Player playerX
            -Player player0
            -Player currentPlayer
            -Player startingPlayer
            -GameStatus gameStatus
            +start() void
            +finish() void
            +getGameStatus() GameStatus
            +isActive() boolean
            +getPlayers() List~Player~
            +checkWinner(Player player) boolean
            +checkWinner(char[][] board, char marker) boolean
            +playerXWon() boolean
            +player0Won() boolean
            +isGameOver() boolean
            +changeTurn() void
            +placeMarker(int boxNumber) boolean
            +getCurrentPlayer() Player
            +getValidMoves() List~Integer~
            +getBoard() char[][]
