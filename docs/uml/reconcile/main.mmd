    namespace Network {
        class Connection {
            -Socket socket
            -BufferedReader in
            -PrintWriter out
            -boolean done
            -Consumer~String~ lineHandler
            -Runnable onDisconnect
            +connect(String host, int port) void
            +send(String text) void
            +startListening(Consumer lineHandler, Runnable onDisconnect) void
            +close() void
            +isConnected() boolean
            +run() void
        }
        class GameServer {
            -Connection connection
            -List~GameListener~ gameListeners
            -List~LobbyListener~ lobbyListeners
            -List~ConnectionListener~ connectionListeners
            -String lastCommand
            -boolean debug
            +addGameListener(GameListener listener) void
            +addLobbyListener(LobbyListener listener) void
            +addConnectionListener(ConnectionListener listener) void
            +start() void
            +login(String name) void
            +getGameList() void
            +getPlayerList() void
            +subscribe(String gameType) void
            +move(int move) void
            +forfeit() void
            +acceptChallenge(int number) void
            +challenge(String player, String game) void
            +logout() void
        }
        class Client {
            -Connection connection
            -GameServer server
            -String gameType
            +connect(String host, int port) void
            +login(String name) void
            +getGameList() void
            +getPlayerList() void
            +subscribe(String game) void
            +challenge(String player) void
