    Game <|.. TicTacToeGame
    TicTacToeGame *-- Board
    TicTacToeGame *-- "2" Player
    TicTacToeGame --> GameStatus

    GameService *-- GameSession : current session
    GameService ..> TicTacToeGame : creates and drives
    GameService ..> AiPlayer : chooses AI moves
    GameSession o-- Game
    GameSession --> GameMode
    AiPlayer ..> TicTacToeGame

    TicTacToeController --> GameService
    TicTacToeController --> GameView
    TicTacToeController ..> TicTacToeGame
    GameView <|.. TicTacToeGameView
    TicTacToeGameView --> TicTacToeController
    TicTacToeGameView *-- "9" TicTacToeTile

    Client *-- Connection
    Client *-- GameServer
    GameServer --> Connection
    GameServer o-- "0..*" GameListener
    GameServer o-- "0..*" LobbyListener
    GameServer o-- "0..*" ConnectionListener
    GameListener --> ResultType
    PrintListener ..|> GameListener
    PrintListener ..|> LobbyListener
    PrintListener ..|> ConnectionListener

    Main --> TuiApplication : starts terminal UI
    Main ..> GuiMainMenuController : loads FXML UI
    GuiMainMenuController ..> ConfigGameController : loads view
    ConfigGameController ..> TicTacToeGameController : configures
    TicTacToeGameController --> TicTacToeController
    TicTacToeGameController ..> GameView : anonymous adapter

    TicTacToeGameApp --> TicTacToeController
    TicTacToeGameApp --> TicTacToeGameView
    SettingsScreen ..> TicTacToeGameApp

    TuiApplication *-- TuiNavigator
    TuiApplication *-- TuiInputHandler
    TuiApplication --> GameService
    TuiNavigator --> TuiView : current
    TuiNavigator --> TuiController : current
    TuiNavigator --> GameService
    TuiNavigator *-- LoginData
    TuiInputHandler --> TuiNavigator
    TuiInputHandler --> TuiController

