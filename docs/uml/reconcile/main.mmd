        }
        class GameMode {
            <<enumeration>>
            PLAYER_VS_PLAYER
            PLAYER_VS_AI
        }
        class GameStatus {
            <<enumeration>>
            NOT_STARTED
            ACTIVE
            FINISHED
        }
    }

